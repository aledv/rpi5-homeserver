# Copia in .env (chmod 600) e compila: il file .env NON va su git
# Notifiche di scrutiny via shoutrrr (https://containrrr.dev/shoutrrr/services/telegram/)
# Notifiche (shoutrrr): es. un webhook generico o Telegram
SCRUTINY_NOTIFY_URLS=generic://your-webhook-host:5000/notify/json?template=json&disabletls=yes
# Alternativa: Telegram diretto
# SCRUTINY_NOTIFY_URLS=telegram://<BOT_TOKEN>@telegram?chats=<CHAT_ID>
