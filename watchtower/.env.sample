# Segreti di watchtower - NON va su git (vedi .gitignore). Compila i valori, poi chmod 600.
# Dopo la compilazione il docker-compose userà ${NOME} al posto dei valori in chiaro.
WATCHTOWER_HTTP_API_TOKEN=
# URL shoutrrr completo, include credenziali
WATCHTOWER_NOTIFICATION_URL=
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PASSWORD=
DOMAIN=
ADMIN_EMAIL=
