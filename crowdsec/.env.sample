# Chiave con cui crowdsec-firewall-bouncer (sull host) si collega a CrowdSec
BOUNCER_KEY_FIREWALL=<DA_COMPILARE>
# Password dell'utente crowdsec-agent (uguale a HOMEPAGE_VAR_CROWDSEC_PASSWORD in homepage/.env)
CROWDSEC_AGENT_PASSWORD=<DA_COMPILARE>
# Chiave di collegamento alla CrowdSec Console (app.crowdsec.net > Security Engines > Enroll)
ENROLL_KEY=<DA_COMPILARE>
