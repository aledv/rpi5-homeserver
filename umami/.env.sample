# Segreti di umami - NON va su git (vedi .gitignore). Compila i valori, poi chmod 600.
# Dopo la compilazione il docker-compose userà ${NOME} al posto dei valori in chiaro.
# URL completo, include la password del DB (es. postgresql://utente:PASSWORD@umami-db:5432/umami)
DATABASE_URL=
APP_SECRET=
POSTGRES_PASSWORD=
DOMAIN=
