# Token di Plex usato da daily_backup.sh (refresh librerie)
PLEX_TOKEN=
# utente Nextcloud (percorso dei file da riscansionare)
NEXTCLOUD_USER=
# destinazione rsync del backup notturno (modulo di un demone rsync), es. 192.168.1.101::USB_DISK
BACKUP_TARGET=<DA_COMPILARE>
# (opzionale) URL di un monitor push di Uptime Kuma per il backup notturno (http://localhost:3001/api/push/<token>)
KUMA_PUSH_URL=
